
<Window x:Class="Lista2.WorkingKalkulator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lista2"
        mc:Ignorable="d"
        Title="WorkingKalkulator" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBox Text="{Binding Display}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" FontSize="30" IsReadOnly="True" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Margin="2"/>

        <Button Content="1" Command="{Binding Path=PressCommand}" CommandParameter="1" Grid.Row="1" Grid.Column="0" Margin="2"/>
        <Button Content="2" Command="{Binding Path=PressCommand}" CommandParameter="2" Grid.Row="1" Grid.Column="1" Margin="2"/>
        <Button Content="3" Command="{Binding Path=PressCommand}" CommandParameter="3" Grid.Row="1" Grid.Column="2" Margin="2"/>
        <Button Content="+" Command="{Binding Path=PressCommand}" CommandParameter="+" Grid.Row="1" Grid.Column="3" Margin="2"/>

        <Button Content="4" Command="{Binding Path=PressCommand}" CommandParameter="4" Grid.Row="2" Grid.Column="0" Margin="2"/>
        <Button Content="5" Command="{Binding Path=PressCommand}" CommandParameter="5" Grid.Row="2" Grid.Column="1" Margin="2"/>
        <Button Content="6" Command="{Binding Path=PressCommand}" CommandParameter="6" Grid.Row="2" Grid.Column="2" Margin="2"/>
        <Button Content="-" Command="{Binding Path=PressCommand}" CommandParameter="-" Grid.Row="2" Grid.Column="3" Margin="2"/>

        <Button Content="7" Command="{Binding Path=PressCommand}" CommandParameter="7" Grid.Row="3" Grid.Column="0" Margin="2"/>
        <Button Content="8" Command="{Binding Path=PressCommand}" CommandParameter="8" Grid.Row="3" Grid.Column="1" Margin="2"/>
        <Button Content="9" Command="{Binding Path=PressCommand}" CommandParameter="9" Grid.Row="3" Grid.Column="2" Margin="2"/>
        <Button Content="*" Command="{Binding Path=PressCommand}" CommandParameter="*" Grid.Row="3" Grid.Column="3" Margin="2"/>

        <Button Content="0" Command="{Binding Path=PressCommand}" CommandParameter="0" Grid.Row="4" Grid.Column="0" Margin="2"/>
        <Button Content="C" Command="{Binding Path=PressCommand}" CommandParameter="C" Grid.Row="4" Grid.Column="1" Margin="2"/>
        <Button Content="=" Command="{Binding Path=PressCommand}" CommandParameter="=" Grid.Row="4" Grid.Column="2" Margin="2"/>
        <Button Content="/" Command="{Binding Path=PressCommand}" CommandParameter="/" Grid.Row="4" Grid.Column="3" Margin="2"/>

    </Grid>
</Window>
