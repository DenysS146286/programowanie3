<Window x:Class="Lista2.kolko_krzyayk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kółko i krzyżyk" Height="480" Width="400">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontSize="20"
                   HorizontalAlignment="Center" Margin="5"/>
        <Button DockPanel.Dock="Bottom" Content="Nowa gra"
                Command="{Binding NewGameCommand}" Margin="5" Height="30"/>

        <UniformGrid Rows="3" Columns="3">
            <Button Content="{Binding Cells[0]}" CommandParameter="0" FontSize="30"/>
            <Button Content="{Binding Cells[1]}" CommandParameter="1" FontSize="30"/>
            <Button Content="{Binding Cells[2]}" CommandParameter="2" FontSize="30"/>
            <Button Content="{Binding Cells[3]}" CommandParameter="3" FontSize="30"/>
            <Button Content="{Binding Cells[4]}" CommandParameter="4" FontSize="30"/>
            <Button Content="{Binding Cells[5]}" CommandParameter="5" FontSize="30"/>
            <Button Content="{Binding Cells[6]}" CommandParameter="6" FontSize="30"/>
            <Button Content="{Binding Cells[7]}" CommandParameter="7" FontSize="30"/>
            <Button Content="{Binding Cells[8]}" CommandParameter="8" FontSize="30"/>
        </UniformGrid>
    </DockPanel>
</Window>