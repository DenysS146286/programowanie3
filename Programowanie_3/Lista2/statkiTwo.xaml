<Window x:Class="Lista2.statkiTwo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player 2" Height="540" Width="900">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="Board">
            <UniformGrid Rows="10" Columns="10"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="CellTemplate">
            <Button Margin="1" Background="{Binding Color}" Content="{Binding Text}"
                    Command="{Binding ClickCommand}"/>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="10">
        <TextBlock Text="Black on your board = ship | Click enemy board to fire | Red = hit | LightGray = miss"
                   FontSize="18" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <StackPanel Margin="10">
                <TextBlock Text="MY SHIPS" HorizontalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding MyBoard}" Width="400" Height="400"
                              ItemsPanel="{StaticResource Board}" ItemTemplate="{StaticResource CellTemplate}"/>
            </StackPanel>
            <StackPanel Margin="10">
                <TextBlock Text="ENEMY" HorizontalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding EnemyBoard}" Width="400" Height="400"
                              ItemsPanel="{StaticResource Board}" ItemTemplate="{StaticResource CellTemplate}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>