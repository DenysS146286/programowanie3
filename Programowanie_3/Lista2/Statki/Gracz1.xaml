<Window x:Class="Lista2.Gracz1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lista2"
        Title="Gracz 1" Height="750" Width="950"
        MinHeight="700" MinWidth="900">

    <Window.Resources>
        <local:KolorConverter x:Key="KolorConverter"/>
    </Window.Resources>

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Czarny = statek | Czerwony = trafienie | Jasnoszary = pudło"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="5"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="MOJA PLANSZA"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="5"/>

                <UniformGrid x:Name="mojaPlansza"
                             Grid.Row="1"
                             Rows="10"
                             Columns="10"/>

            </Grid>

            <Grid Grid.Column="1" Margin="5">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PLANSZA PRZECIWNIKA"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="5"/>

                <UniformGrid x:Name="planszaPrzeciwnika"
                             Grid.Row="1"
                             Rows="10"
                             Columns="10"/>

            </Grid>

        </Grid>

        <TextBlock x:Name="status"
                   Grid.Row="2"
                   Text="Twoja kolej"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="10"/>

    </Grid>
</Window>
