<Window x:Class="Lista2.WorkingKolkoKrzyzyk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kolko i krzyzyk" Height="450" Width="450">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   Text="{Binding Status}"
                   FontSize="25"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <Button Grid.Row="1" Grid.Column="0" Margin="3" FontSize="40" Tag="0" Content="{Binding Pola[0]}" Click="Button_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Margin="3" FontSize="40" Tag="1" Content="{Binding Pola[1]}" Click="Button_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Margin="3" FontSize="40" Tag="2" Content="{Binding Pola[2]}" Click="Button_Click"/>
        <Button Grid.Row="2" Grid.Column="0" Margin="3" FontSize="40" Tag="3" Content="{Binding Pola[3]}" Click="Button_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Margin="3" FontSize="40" Tag="4" Content="{Binding Pola[4]}" Click="Button_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Margin="3" FontSize="40" Tag="5" Content="{Binding Pola[5]}" Click="Button_Click"/>
        <Button Grid.Row="3" Grid.Column="0" Margin="3" FontSize="40" Tag="6" Content="{Binding Pola[6]}" Click="Button_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Margin="3" FontSize="40" Tag="7" Content="{Binding Pola[7]}" Click="Button_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Margin="3" FontSize="40" Tag="8" Content="{Binding Pola[8]}" Click="Button_Click"/>

    </Grid>
</Window>
