<Window x:Class="Lista1.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lista1"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="wynik" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" FontSize="30" Text="0"/>

            <Button Content="1" Grid.Row="1" Grid.Column="0" Click="On_Click" Margin="2"/>
            <Button Content="2" Grid.Row="1" Grid.Column="1" Click="On_Click" Margin="2"/>
            <Button Content="3" Grid.Row="1" Grid.Column="2" Click="On_Click" Margin="2"/>
            <Button Content="+" Grid.Row="1" Grid.Column="3" Click="On_Click" Margin="2"/>

            <Button Content="4" Grid.Row="2" Grid.Column="0" Click="On_Click" Margin="2"/>
            <Button Content="5" Grid.Row="2" Grid.Column="1" Click="On_Click" Margin="2"/>
            <Button Content="6" Grid.Row="2" Grid.Column="2" Click="On_Click" Margin="2"/>
            <Button Content="-" Grid.Row="2" Grid.Column="3" Click="On_Click" Margin="2"/>

            <Button Content="7" Grid.Row="3" Grid.Column="0" Click="On_Click" Margin="2"/>
            <Button Content="8" Grid.Row="3" Grid.Column="1" Click="On_Click" Margin="2"/>
            <Button Content="9" Grid.Row="3" Grid.Column="2" Click="On_Click" Margin="2"/>
            <Button Content="*" Grid.Row="3" Grid.Column="3" Click="On_Click" Margin="2"/>

            <Button Content="0" Grid.Row="4" Grid.Column="0" Click="On_Click" Margin="2"/>
            <Button Content="C" Grid.Row="4" Grid.Column="1" Click="On_Click" Margin="2"/>
            <Button Content="=" Grid.Row="4" Grid.Column="2" Click="On_Click" Margin="2"/>
            <Button Content="/" Grid.Row="4" Grid.Column="3" Click="On_Click" Margin="2"/>
        </Grid>
    </Grid>
</Window>
