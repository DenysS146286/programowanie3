<Window x:Class="Lista1.Window4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lista1"
        mc:Ignorable="d"
        Title="Window4" Height="350" Width="340">
    <Grid>
        <DockPanel LastChildFill="True">
            <Button Content="Top" Background="Red" Height="70" DockPanel.Dock="Top"/>
            <Button Content="Bottom" Height="30" DockPanel.Dock="Bottom"/>
            <Button Content="Left" Width="35" DockPanel.Dock="Left"/> 
            <Button Content="Right" Width="40" DockPanel.Dock="Right"/>
            <Grid>
                <Button Content="Top2" Background="Green" Width="105" Height="103" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                <Button Content="Top3" Background="Blue" Height="35" Width="145" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,57"/>
                <Button Content="Fill" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="145" Height="60"/>
                <Button Content="Right3" Width="60" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,60,10"/>
                <Button Content="Right2" Width="60" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
