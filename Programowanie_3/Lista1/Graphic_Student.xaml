<Window x:Class="Lista1.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lista1"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800">
    <StackPanel Margin="10">
        <Label Content="Student Name"/>
        <TextBox/>
        <Label Content="Student Surname"/>
        <TextBox/>
        <Label Content="Student Birth Date"/>
        <DatePicker/>
        <Label Content="Student Semestr"/>
        <ComboBox/>
        <ComboBoxItem Content="Semestr 1"/>
        <ComboBoxItem Content="Semestr 2"/>
        <ComboBoxItem Content="Semestr 3"/>
        <ComboBoxItem Content="Semestr 4"/>
        <ComboBoxItem Content="Semestr 5"/>
        <ComboBoxItem Content="Semestr 6"/>
        <ComboBoxItem Content="Semestr 7"/>
        <ComboBoxItem Content="Semestr 8"/>
        <ComboBoxItem Content="Semestr 9"/>
        <ComboBoxItem Content="Semestr 10"/>
        <Button Content="Dodaj studenta" Click="Button_Click"/>
    </StackPanel>
</Window>
